#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#include "zmk-helpers/key-labels/sofle.h"

#define BASE     0
#define TAP      1
#define NAV      2
#define MOUSE    3
#define MEDIA    4
#define NUM      5
#define SYM      6
#define FUN      7
#define TASCTRL  8
#define TASLD    9
#define TASLDB   10
#define TASSV    11

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        
        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "grub";
// --------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3   |  4  |   5   |                 |   6   |  7  |  8  |  9  |  0  | BOOT |
// | RST  |  Q  |  W  |  E   |  R  |   T   |                 |   Y   |  U  |  I  |  O  |  P  | RST  |
// |      |  A  |  S  |  D   |  F  |   G   |                 |   H   |  J  |  K  |  L  |  '  |      |
// |      |  Z  |  X  |  C   |  V  |   B   | MUTE |  | PSCR  |   N   |  M  |  ,  |  .  |  /  |      |
//              |     |      | ESC | SPACE | TAB  |  | ENTER | BKSPC | DEL |     |     |
            bindings = <
&none       &none       &none       &none           &none           &none					                            &none           &none           &none           &none           &none           &none
&bootloader &kp Q       &kp W       &kp E           &kp R	        &kp T							                    &kp Y           &kp U           &kp I           &kp O           &kp P           &bootloader
&sys_reset  &hml LGUI A &hml LALT S &hml LCTRL D    &hml LSHFT F 	&kp G							                    &kp H           &hmr RSHFT J    &hmr LCTRL K    &hmr LALT L     &hmr LGUI SQT   &sys_reset
&to TASCTRL &kp Z       &hml RALT X &kp C           &kp V           &kp B           &kp C_MUTE          &kp PSCRN       &kp N           &kp M           &kp COMMA       &hmr RALT DOT   &kp FSLH        &tog TAP
                        &none	    &none           &u_lt MEDIA ESC &u_lt SYM SPACE &u_lt NAV TAB	    &u_lt MOUSE RET &u_lt NUM BSPC  &u_lt FUN DEL   &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tap_layer {
            display-name = "flea";
// -------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |   5   |                 |   6   |  7  |  8  |  9  |  0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |   T   |                 |   Y   |  U  |  I  |  O  |  P  | RST  |
// |      |  A  |  S  |  D  |  F  |   G   |                 |   H   |  J  |  K  |  L  |  '  |      |
// |      |  Z  |  X  |  C  |  V  |   B   | MUTE |  | PSCR  |   N   |  M  |  ,  |  .  |  /  |      |
//              |     |     | ESC | SPACE | TAB  |  | ENTER | BKSPC | DEL |     |     |
            bindings = <
&trans  &none   &none   &none   &none   &none					            &none       &none   &none       &none   &none       &trans
&trans  &kp Q   &kp W   &kp E   &kp R	&kp T							    &kp Y       &kp U   &kp I       &kp O   &kp P       &trans
&trans  &kp A   &kp S   &kp D	&kp F   &kp G					            &kp H       &kp J   &kp K       &kp L   &kp SQT     &trans
&trans  &kp Z   &kp X	&kp C   &kp V   &kp B       &kp C_MUTE  &kp PSCRN   &kp N       &kp M   &kp COMMA   &kp DOT &kp FSLH    &trans
                &none	&none   &kp ESC &kp SPACE   &kp TAB	    &kp RET     &kp BSPC    &kp DEL &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "mii";
// ----------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2   |  3   |  4   |  5  |               |  6    |   7   |  8   |  9  |   0  | BOOT |
// | RST  |  Q  |  W   |  E   |  R   |  T  |               | REDO  | PASTE | COPY | CUT | UNDO | RST  |
// |      | END | PGUP | PGDN | HOME |  G  |               |  H    |   🠜   |  🠟   |  🠝  |   🠞  |      |
// |      |  Z  |  X   |  C   |  V   |  B  |    |  |       |  N    |   M   |  ,   |  .  |  /   |      |
//              |      |      |      |     |    |  | ENTER | BKSPC |  DEL  |      |     |
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans						&trans          &trans      &trans      &trans      &trans      &trans
&trans  &kp K_UNDO  &kp K_CUT   &kp K_COPY  &kp K_PASTE	&kp K_AGAIN					&kp K_AGAIN     &kp K_PASTE &kp K_COPY  &kp K_CUT   &kp K_UNDO  &trans
&trans  &kp END     &kp PG_UP   &kp PG_DN	&kp HOME	&kp INS				        &u_caps_word    &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans
&trans  &trans      &trans	    &trans      &trans      &trans      &trans  &trans  &trans          &trans      &trans      &trans      &trans      &trans
                    &none	    &none       &none       &none       &none	&kp RET &kp BSPC        &kp DEL     &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            display-name = "mawo";
// ------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |  5  |               |  6   |   7   |  8   |  9  |   0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |  T  |               | REDO | PASTE | COPY | CUT | UNDO | RST  |
// |      |  A  |  S  |  D  |  F  |  G  |               |  H   |   ⬅   |  ⬇   |  ⬆  |  ➡   |      |
// |      |  Z  |  X  |  C  |  V  |  B  |    |  |       |  N   |   ⇦   |  ⇧   |  ⇩  |  ⇨   |      |
//              |     |     |     |     |    |  | MB_L  | MB_R | MB_M  |      |     |
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans						        &trans      &trans          &trans          &trans          &trans          &trans
&trans  &trans      &trans      &trans      &trans      &trans						        &kp K_AGAIN &kp K_PASTE     &kp K_COPY      &kp K_CUT       &kp K_UNDO      &trans
&trans  &trans      &trans      &trans      &trans      &trans						        &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &trans
&trans  &trans      &trans  	&trans      &trans      &trans      &trans      &trans      &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &trans
                    &none	    &none       &none       &none       &none	    &mkp MB1    &mkp MB2    &mkp MB3        &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media_layer {
            display-name = "awoo";
// ----------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |  5  |             |  6   |   7  |  8   |  9   |   0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |  T  |             | CLR  | BL 0 | BL 1 | BL 2 | BL 3 | RST  |
// |      |  A  |  S  |  D  |  F  |  G  |             |  H   |  ⏮   |  🕩   |  🕪   |  ⏭   |      |
// |      |  Z  |  X  |  C  |  V  |  B  |    |  |     | TOG  | USB  | BLE  |      |      |      |
//              |     |     |     |     |    |  | ⏹   |  ⏯   |  🕨   |      |      |
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans						    &trans              &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans			    		    &bt BT_CLR          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &trans
&trans  &trans  &trans  &trans  &trans  &trans					        &ext_power EP_TOG   &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &none       &out OUT_TOG        &out OUT_USB    &out OUT_BLE    &none           &none           &trans
                &none	&none   &none   &none   &none	    &kp C_STOP  &kp C_PP            &kp C_MUTE      &none           &none
            >;                                         

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "mee";
// ------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |              |     |     |     |     |     | BOOT |
// | RST  |  !  |  @  |  #  |  $  |  %  |              |  ^  |  &  |  *  |  (  |  )  | RST  |
// |      |  1  |  2  |  3  |  4  |  5  |              |  6  |  7  |  8  |  9  |  0  |      |
// |      |     |     |     |     |     |     |  |     |     |     |  ,  |  .  |  /  |      |
//              |     |     |  =  |  +  |  -  |  |     |     |     |     |     |
            bindings = <
&trans  &trans      &trans  &trans      &trans      &trans						    &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT                       &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    &trans
&trans  &kp N1      &kp N2  &kp N3      &kp N4      &kp N5							&kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &trans
&trans  &kp Z       &kp X	&kp C       &kp V       &kp B       &none       &none   &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &trans
                    &none	&none       &kp EQUAL   &kp PLUS    &kp MINUS	&none   &none       &none       &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "maw";
// ------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |              |     |     |     |     |     | BOOT |
// | RST  |  !  |  @  |  #  |  $  |  %  |              |  ^  |  &  |  *  |  (  |  )  | RST  |
// |      |  "  |  '  |  [  |  ]  |  \  |              |  |  |  {  |  }  |  ;  |  :  |      |
// |      |     |     |  =  |  +  |  -  |     |  |     |  `  |  ~  |  ,  |  .  |  /  |      |
//              |     |     |  (  |  )  |  _  |  |     |     |     |     |     |
            bindings = <
&trans  &trans      &trans  &trans      &trans      &trans						        &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT                           &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    &trans
&trans  &kp DQT     &kp SQT &kp LBKT    &kp RBKT    &kp BSLH						    &kp PIPE    &kp LBRC    &kp RBRC    &kp SEMI    &kp COLON   &trans
&trans  &kp Z       &kp X	&kp EQUAL   &kp PLUS    &kp MINUS   &none       &none       &kp GRAVE   &kp TILDE   &trans      &trans      &trans      &trans
                    &none	&none       &none       &none       &none	    &kp UNDER   &kp LPAR    &kp RPAR    &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        fun_layer {
            display-name = "mrow";
// ----------------------------------------------------------------------------------------------
// | BOOT |     |     |     |      |      |                |     |     |     |     |     | BOOT |
// | RST  |     |     |     | PSCR |      |                |     |     |     |     |     | RST  |
// |      | F2  | F3  | F4  | F5   |  F6  |                | F7  | F8  | F9  | F10 | F11 |      |
// |      | F1  |     |     | COMP |      |       |  |     |     |     |     |     | F12 |      |
//              |     |     | ALT  | CTRL | SHIFT |  |     |     |     |     |     |
            bindings = <
&trans  &none   &none   &none   &none       &none							&none   &none   &none   &none   &none   &trans
&trans  &none   &none   &none   &kp PSCRN	&none							&none   &none   &none   &none   &none   &trans
&trans  &kp F2  &kp F3  &kp F4	&kp F5	    &kp F6							&kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &trans
&trans  &kp F1  &none	&none   &kp K_APP   &none       &none       &none   &none   &none   &none   &none   &kp F12 &trans
                &none	&none   &kp LALT    &kp LCTRL   &kp LSHFT	&none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tas_ctrl_layer {
            display-name = "gub";
// --------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |               |     |     |     |     |     |     |
// | RST  |     |     |     |     |     |               |     |     |     |     |     |     |
// |      |  A  |  S  |  D  |  F  |  G  |               |     |     |     |     |     |     |
// |      |     |     |     |  V  |     |      |  |     |     |     |     |     |     |     |
//              |     |     |     |     |      |  |     |     |     |     |     |
            bindings = <
&trans      &none       &none           &none           &none       &none					            &none   &none   &none   &none   &none   &trans
&trans      &none       &kp K_COPY      &kp K_PASTE     &kp LSHFT   &none					            &none   &none   &none   &none   &none   &trans
&trans      &kp K_CUT   &kp S           &kp D           &kp F       &kp G					            &none   &none   &none   &none   &none   &trans
&to BASE    &kp A       &kp LC(PLUS)    &kp LC(MINUS)   &kp LC(D)   &kp B       &none           &none   &none   &none   &none   &none   &none   &none
                        &none	        &to BASE        &mo TASSV   &mo TASLD   &mo TASLDB      &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tas_load_layer {
            display-name = "gub";
// --------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |               |     |     |     |     |     |     |
// | RST  |     |     |     |     |     |               |     |     |     |     |     |     |
// |      |  A  |  S  |  D  |  F  |  G  |               |     |     |     |     |     |     |
// |      |     |     |     |  V  |     |      |  |     |     |     |     |     |     |     |
//              |     |     |     |     |      |  |     |     |     |     |     |
            bindings = <
&trans  &none   &none   &none       &none   &none					    &none   &none   &none   &none   &none   &trans
&trans  &none   &kp F7  &kp F8      &kp F9  &kp F10					    &none   &none   &none   &none   &none   &trans
&trans  &kp F6  &kp F2  &kp F3      &kp F4  &kp F5					    &none   &none   &none   &none   &none   &trans
&none   &kp F1  &none   &none       &none   &none   &none       &none   &none   &none   &none   &none   &none   &none
                &none	&to BASE    &none   &none   &none       &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tas_loadb_layer {
            display-name = "gub";
// --------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |               |     |     |     |     |     |     |
// | RST  |     |     |     |     |     |               |     |     |     |     |     |     |
// |      |  A  |  S  |  D  |  F  |  G  |               |     |     |     |     |     |     |
// |      |     |     |     |  V  |     |      |  |     |     |     |     |     |     |     |
//              |     |     |     |     |      |  |     |     |     |     |     |
            bindings = <
&trans  &none   &none   &none   &none   &none					    &none   &none   &none   &none   &none   &trans
&trans  &none   &kp N7  &kp N8  &kp N9  &kp N0					    &none   &none   &none   &none   &none   &trans
&trans  &kp N6  &kp N2  &kp N3  &kp N4  &kp N5					    &none   &none   &none   &none   &none   &trans
&none   &kp N1  &none   &none   &none   &none   &none       &none   &none   &none   &none   &none   &none   &none
                &none	&trans  &none   &none   &none       &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tas_save_layer {
            display-name = "gub";
// --------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |               |     |     |     |     |     |     |
// | RST  |     |     |     |     |     |               |     |     |     |     |     |     |
// |      |  A  |  S  |  D  |  F  |  G  |               |     |     |     |     |     |     |
// |      |     |     |     |  V  |     |      |  |     |     |     |     |     |     |     |
//              |     |     |     |     |      |  |     |     |     |     |     |
            bindings = <
&trans  &none       &none       &none       &none       &none		     			    &none   &none   &none   &none   &none   &trans
&trans  &none       &kp LS(F7)  &kp LS(F8)  &kp LS(F9)  &kp LS(F10)	    			    &none   &none   &none   &none   &none   &trans
&trans  &kp LS(F6)  &kp LS(F2)  &kp LS(F3)  &kp LS(F4)  &kp LS(F5)	    			    &none   &none   &none   &none   &none   &trans
&none   &kp LS(F1)  &none       &none       &none       &none       &none       &none   &none   &none   &none   &none   &none   &none
                    &none	    &trans      &none       &none       &none       &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
