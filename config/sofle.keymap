#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#include "zmk-helpers/key-labels/sofle.h"

#define BASE   0
#define TAP    1
#define NAV    2
#define MOUSE  3
#define MEDIA  4
#define NUM    5
#define SYM    6
#define FUN    7

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };
        
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        u_lt: u_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        
        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "grub";
// -------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3   |  4   |  5   |                 |   6   |  7  |  8  |  9  |  0  | BOOT |
// | RST  |  Q  |  W  |  E   |  R   |  T   |                 |   Y   |  U  |  I  |  O  |  P  | RST  |
// |      |  A  |  S  |  D   |  F   |  G   |                 |   H   |  J  |  K  |  L  |  '  |      |
// |      |  Z  |  X  |  C   |  V   |  B   | MUTE |  | PSCR  |   N   |  M  |  ,  |  .  |  /  |      |
//              |     |      | ESC | SPACE | TAB  |  | ENTER | BKSPC | DEL |     |     |
            bindings = <
&bootloader &kp N1      &kp N2      &kp N3          &kp N4          &kp N5							                &kp N6              &kp N7          &kp N8          &kp N9          &kp N0          &bootloader
&sys_reset  &kp Q       &kp W       &kp E           &kp R	        &kp T							                &kp Y               &kp U           &kp I           &kp O           &kp P           &sys_reset
&none       &hml LGUI A &hml LALT S &hml LCTRL D    &hml LSHFT F 	&kp G							                &kp H               &hmr LSHFT J    &hmr LCTRL K    &hmr LALT L    &hmr LGUI SQT    &none
&none       &kp Z       &hml RALT X &kp C           &kp V           &kp B           &kp C_MUTE          &kp PSCRN   &kp N               &kp M           &kp COMMA       &hmr RALT DOT  &kp FSLH         &none
                        &none	    &none           &u_lt MEDIA ESC &u_lt NAV SPACE &u_lt MOUSE TAB	    &u_lt SYM RET &u_lt NUM BSPC    &u_lt FUN DEL   &tog TAP        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tap_layer {
            display-name = "flea";
// ------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |   5   |                 |   6   |  7  |  8  |  9  |  0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |   T   |                 |   Y   |  U  |  I  |  O  |  P  | RST  |
// |      |  A  |  S  |  D  |  F  |   G   |                 |   H   |  J  |  K  |  L  |  '  |      |
// |      |  Z  |  X  |  C  |  V  |   B   | MUTE |  | PSCR  |   N   |  M  |  ,  |  .  |  /  |      |
//              |     |     | ESC | SPACE | TAB  |  | ENTER | BKSPC | DEL |     |     |
            bindings = <
&bootloader &kp N1  &kp N2  &kp N3  &kp N4  &kp N5							    &kp N6      &kp N7  &kp N8      &kp N9  &kp N0      &bootloader
&sys_reset  &kp Q   &kp W   &kp E   &kp R	&kp T							    &kp Y       &kp U   &kp I       &kp O   &kp P       &sys_reset
&none       &kp A   &kp S   &kp D	&kp F   &kp G					            &kp H       &kp J   &kp K       &kp L   &kp SQT     &none
&none       &kp Z   &kp X	&kp C   &kp V   &kp B       &kp C_MUTE  &kp PSCRN   &kp N       &kp M   &kp COMMA   &kp DOT &kp FSLH    &none
                    &none	&none   &kp ESC &kp SPACE   &kp TAB	    &kp RET     &kp BSPC    &kp DEL &tog TAP  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "mii";
// ----------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2   |  3   |  4   |  5  |               |  6    |   7   |  8   |  9  |   0  | BOOT |
// | RST  |  Q  |  W   |  E   |  R   |  T  |               | REDO  | PASTE | COPY | CUT | UNDO | RST  |
// |      | END | PGUP | PGDN | HOME |  G  |               |  H    |   🠜   |  🠟   |  🠝  |   🠞  |      |
// |      |  Z  |  X   |  C   |  V   |  B  |    |  |       |  N    |   M   |  ,   |  .  |  /   |      |
//              |      |      |      |     |    |  | ENTER | BKSPC |  DEL  |      |     |
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans						&trans          &trans      &trans      &trans      &trans      &trans
&trans  &kp K_UNDO  &kp K_CUT   &kp K_COPY  &kp K_PASTE	&kp K_AGAIN					&kp K_AGAIN     &kp K_PASTE &kp K_COPY  &kp K_CUT   &kp K_UNDO  &trans
&none   &kp END     &kp PG_UP   &kp PG_DN	&kp HOME	&kp INS						&u_caps_word    &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &none
&none   &trans      &trans	    &trans      &trans      &trans      &trans  &trans  &trans          &trans      &trans      &trans      &trans      &none
                    &none	    &none       &none       &none       &none	&kp RET &kp BSPC        &kp DEL     &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            display-name = "mawo";
// ------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |  5  |               |  6   |   7   |  8   |  9  |   0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |  T  |               | REDO | PASTE | COPY | CUT | UNDO | RST  |
// |      |  A  |  S  |  D  |  F  |  G  |               |  H   |   ⬅   |  ⬇   |  ⬆  |  ➡   |      |
// |      |  Z  |  X  |  C  |  V  |  B  |    |  |       |  N   |   ⇦   |  ⇧   |  ⇩  |  ⇨   |      |
//              |     |     |     |     |    |  | MB_L  | MB_R | MB_M  |      |     |
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans						        &trans      &trans          &trans          &trans          &trans          &trans
&trans  &trans      &trans      &trans      &trans      &trans						        &kp K_AGAIN &kp K_PASTE     &kp K_COPY      &kp K_CUT       &kp K_UNDO      &trans
&none   &trans      &trans      &trans      &trans      &trans						        &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &none
&none   &trans      &trans  	&trans      &trans      &trans      &trans      &trans      &trans      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &none
                    &none	    &none       &none       &none       &none	    &mkp MB1    &mkp MB2    &mkp MB3        &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media_layer {
            display-name = "awoo";
// ------------------------------------------------------------------------------------------------
// | BOOT |  1  |  2  |  3  |  4  |  5  |               |  6   |   7   |  8   |  9  |   0  | BOOT |
// | RST  |  Q  |  W  |  E  |  R  |  T  |               | REDO | PASTE | COPY | CUT | UNDO | RST  |
// |      |  A  |  S  |  D  |  F  |  G  |               |  H   |   ⬅   |  ⬇   |  ⬆  |  ➡   |      |
// |      |  Z  |  X  |  C  |  V  |  B  |    |  |       |  N   |   ⇦   |  ⇧   |  ⇩  |  ⇨   |      |
//              |     |     |     |     |    |  | MB_L  | MB_R | MB_M  |      |     |
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans						    &trans              &trans          &trans          &trans          &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans			    		    &bt BT_CLR          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &trans
&none   &trans  &trans  &trans  &trans  &trans					        &ext_power EP_TOG   &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &none
&none   &trans  &trans  &trans  &trans  &trans  &trans      &none       &out OUT_TOG        &out OUT_USB    &out OUT_BLE    &none           &none           &none
                &none	&none   &none   &none   &none	    &kp C_STOP  &kp C_PP            &kp C_MUTE      &none           &none
            >;                                         

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "mee";
// ------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |              |     |     |     |     |     | BOOT |
// | RST  |  !  |  @  |  #  |  $  |  %  |              |  ^  |  &  |  *  |  (  |  )  | RST  |
// |      |  1  |  2  |  3  |  4  |  5  |              |  6  |  7  |  8  |  9  |  0  |      |
// |      |     |     |     |     |     |     |  |     |     |     |  ,  |  .  |  /  |      |
//              |     |     |  =  |  +  |  -  |  |     |     |     |     |     |
            bindings = <
&bootloader &trans      &trans  &trans      &trans      &trans						    &trans      &trans      &trans      &trans      &trans      &bootloader
&sys_reset  &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT                       &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    &sys_reset
&none       &kp N1      &kp N2  &kp N3      &kp N4      &kp N5							&kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &none
&none       &kp Z       &kp X	&kp C       &kp V       &kp B       &none       &none   &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &none
                        &none	&none       &kp EQUAL   &kp PLUS    &kp MINUS	&none   &none       &none       &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            display-name = "maw";
// ------------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |              |     |     |     |     |     | BOOT |
// | RST  |  !  |  @  |  #  |  $  |  %  |              |  ^  |  &  |  *  |  (  |  )  | RST  |
// |      |  "  |  '  |  [  |  ]  |  \  |              |  |  |  {  |  }  |  ;  |  :  |      |
// |      |     |     |  =  |  +  |  -  |     |  |     |  `  |  ~  |  ,  |  .  |  /  |      |
//              |     |     |  (  |  )  |  _  |  |     |     |     |     |     |
            bindings = <
&trans  &trans      &trans  &trans      &trans      &trans						    &trans      &trans      &trans      &trans      &trans      &trans
&trans  &kp EXCL    &kp AT  &kp HASH    &kp DLLR    &kp PRCNT                       &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR    &trans
&none   &kp DQT     &kp SQT &kp LBKT    &kp RBKT    &kp BSLH						&kp PIPE    &kp LBRC    &kp RBRC    &kp SEMI    &kp COLON   &none
&none   &kp Z       &kp X	&kp EQUAL   &kp PLUS    &kp MINUS   &none       &none   &kp GRAVE   &kp TILDE   &trans      &trans      &trans      &none
                    &none	&none       &kp LPAR    &kp RPAR    &kp UNDER	&none   &none       &none       &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        fun_layer {
            display-name = "mrow";
// ------------------------------------------------------------------------------------------
// | BOOT |     |     |     |      |      |                |     |     |     |     |     | BOOT |
// | RST  |     |     |     | PSCR |      |                |     |     |     |     |     | RST  |
// |      | F2  | F3  | F4  | F5   |  F6  |                | F7  | F8  | F9  | F10 | F11 |      |
// |      | F1  |     |     | COMP |      |       |  |     |     |     |     |     | F12 |      |
//              |     |     | ALT  | CTRL | SHIFT |  |     |     |     |     |     |
            bindings = <
&trans  &none   &none   &none   &none       &none							&none   &none   &none   &none   &none   &trans
&trans  &none   &none   &none   &none	    &none							&none   &none   &none   &none   &none   &trans
&none   &kp F2  &kp F3  &kp F4	&kp F5	    &kp F6							&kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &none
&none   &kp F1  &none	&none   &kp K_APP   &none       &none       &none   &none   &none   &none   &none   &kp F12 &none
                &none	&none   &kp LALT    &kp LCTRL   &kp LSHFT	&none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
